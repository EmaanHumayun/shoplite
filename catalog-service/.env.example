# Catalog Service Environment Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shoplite_db
DB_USER=shoplite_user
DB_PASSWORD=shoplite_password
DB_POOL_MAX=20
DB_TIMEOUT_MS=5000

# Optional Database URL (Takes precedence if set)
# DATABASE_URL=postgresql://shoplite_user:shoplite_password@localhost:5432/shoplite_db

# CORS Allowed Origins
CORS_ORIGIN=*
